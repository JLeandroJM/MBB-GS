
import json
import subprocess
import sys
from pathlib import Path

import numpy as np
from scipy.io import wavfile
from scipy import signal


RAIZ = Path(__file__).resolve().parents[2]


def audio_to_float32(data):
    if data.dtype == np.int16:
        y = data.astype(np.float32) / 32768.0
    elif data.dtype == np.int32:
        y = data.astype(np.float32) / 2147483648.0
    elif data.dtype == np.uint8:
        y = (data.astype(np.float32) - 128.0) / 128.0
    else:
        y = data.astype(np.float32)

    y = np.nan_to_num(y)
    y = np.clip(y, -1.0, 1.0)
    return y


def guardar_wav_stereo(ruta, sr, left, right):
    n = min(len(left), len(right))
    y = np.stack([left[:n], right[:n]], axis=1).astype(np.float32)
    y = np.nan_to_num(y)

    max_abs = np.max(np.abs(y))
    if max_abs > 1.0:
        y = y / max_abs

    y_i16 = (np.clip(y, -1.0, 1.0) * 32767.0).astype(np.int16)
    wavfile.write(str(ruta), int(sr), y_i16)


def leer_wav_float(ruta):
    sr, data = wavfile.read(str(ruta))
    y = audio_to_float32(data)
    return int(sr), y


def cargar_original_stereo(ruta_audio, sr_objetivo=None, max_segundos=None):
    sr, data = wavfile.read(str(ruta_audio))
    y = audio_to_float32(data)

    if y.ndim == 1:
        y = np.stack([y, y], axis=1)

    if y.shape[1] > 2:
        y = y[:, :2]

    if sr_objetivo is not None and int(sr_objetivo) != int(sr):
        gcd = np.gcd(int(sr), int(sr_objetivo))
        up = int(sr_objetivo) // gcd
        down = int(sr) // gcd
        y_left = signal.resample_poly(y[:, 0], up, down).astype(np.float32)
        y_right = signal.resample_poly(y[:, 1], up, down).astype(np.float32)
        n = min(len(y_left), len(y_right))
        y = np.stack([y_left[:n], y_right[:n]], axis=1)
        sr = int(sr_objetivo)

    if max_segundos is not None:
        n = int(float(max_segundos) * int(sr))
        y = y[:n]

    return int(sr), y


def leer_metricas_txt(ruta):
    datos = {}

    if not ruta.exists():
        return datos

    with open(ruta, "r", encoding="utf-8", errors="replace") as f:
        for linea in f:
            linea = linea.strip()
            if not linea or "=" not in linea:
                continue

            k, v = linea.split("=", 1)
            k = k.strip()
            v = v.strip()

            try:
                datos[k] = float(v)
            except ValueError:
                datos[k] = v

    return datos


def calcular_metricas_stereo(original, recon):
    n = min(len(original), len(recon))
    original = original[:n].astype(np.float32)
    recon = recon[:n].astype(np.float32)

    mse = float(np.mean((original - recon) ** 2))
    potencia = float(np.mean(original ** 2))
    snr = 10.0 * np.log10(potencia / max(mse, 1e-12))

    mse_l = float(np.mean((original[:, 0] - recon[:, 0]) ** 2))
    mse_r = float(np.mean((original[:, 1] - recon[:, 1]) ** 2))

    potencia_l = float(np.mean(original[:, 0] ** 2))
    potencia_r = float(np.mean(original[:, 1] ** 2))

    snr_l = 10.0 * np.log10(potencia_l / max(mse_l, 1e-12))
    snr_r = 10.0 * np.log10(potencia_r / max(mse_r, 1e-12))

    return {
        "samples_comparados": int(n),
        "mse_wave_stereo": mse,
        "snr_stereo_db": float(snr),
        "mse_wave_left": mse_l,
        "mse_wave_right": mse_r,
        "snr_wave_left_db": float(snr_l),
        "snr_wave_right_db": float(snr_r),
    }


def escribir_metricas_stereo(ruta, datos):
    with open(ruta, "w", encoding="utf-8") as f:
        for k, v in datos.items():
            if isinstance(v, float):
                f.write(f"{k}={v:.8f}\n")
            else:
                f.write(f"{k}={v}\n")


def main():
    import argparse

    parser = argparse.ArgumentParser()
    parser.add_argument("--config", required=True)
    args = parser.parse_args()

    ruta_cfg = Path(args.config)
    if not ruta_cfg.is_absolute():
        ruta_cfg = RAIZ / ruta_cfg

    with open(ruta_cfg, "r", encoding="utf-8-sig") as f:
        cfg = json.load(f)

    nombre_base = cfg["nombre_experimento"]

    out_stereo = RAIZ / "outputs" / "audio" / nombre_base
    out_left = out_stereo / "LEFT"
    out_right = out_stereo / "RIGHT"
    out_stereo.mkdir(parents=True, exist_ok=True)

    cfg_left = dict(cfg)
    cfg_right = dict(cfg)

    cfg_left["nombre_experimento"] = nombre_base + "/LEFT"
    cfg_right["nombre_experimento"] = nombre_base + "/RIGHT"

    cfg_left["canal"] = "left"
    cfg_right["canal"] = "right"

    tmp_dir = out_stereo / "_tmp_configs"
    tmp_dir.mkdir(parents=True, exist_ok=True)

    ruta_left_cfg = tmp_dir / "config_LEFT.json"
    ruta_right_cfg = tmp_dir / "config_RIGHT.json"

    with open(ruta_left_cfg, "w", encoding="utf-8") as f:
        json.dump(cfg_left, f, indent=2)

    with open(ruta_right_cfg, "w", encoding="utf-8") as f:
        json.dump(cfg_right, f, indent=2)

    with open(out_stereo / "config_stereo_original.json", "w", encoding="utf-8") as f:
        json.dump(cfg, f, indent=2)

    print("============================================================")
    print(" TRAIN AUDIO STEREO")
    print("============================================================")
    print(f"config base : {ruta_cfg}")
    print(f"salida      : {out_stereo}")
    print(f"LEFT        : {out_left}")
    print(f"RIGHT       : {out_right}")
    print("============================================================")

    train_script = RAIZ / "scripts" / "AUDIO_SCRIPTS" / "train_audio_config.py"

    print("")
    print("=== ENTRENANDO CANAL LEFT ===")
    subprocess.check_call([
        sys.executable,
        str(train_script),
        "--config",
        str(ruta_left_cfg),
    ], cwd=str(RAIZ))

    print("")
    print("=== ENTRENANDO CANAL RIGHT ===")
    subprocess.check_call([
        sys.executable,
        str(train_script),
        "--config",
        str(ruta_right_cfg),
    ], cwd=str(RAIZ))

    print("")
    print("=== UNIENDO STEREO ===")

    sr_l, recon_l = leer_wav_float(out_left / "recon_fase_original.wav")
    sr_r, recon_r = leer_wav_float(out_right / "recon_fase_original.wav")

    if sr_l != sr_r:
        raise RuntimeError("Los sample rates LEFT y RIGHT no coinciden")

    guardar_wav_stereo(
        out_stereo / "recon_stereo_fase_original.wav",
        sr_l,
        recon_l,
        recon_r,
    )

    sr_gl_l, gl_l = leer_wav_float(out_left / "recon_griffinlim.wav")
    sr_gl_r, gl_r = leer_wav_float(out_right / "recon_griffinlim.wav")

    if sr_gl_l != sr_gl_r:
        raise RuntimeError("Los sample rates Griffin-Lim LEFT y RIGHT no coinciden")

    guardar_wav_stereo(
        out_stereo / "recon_stereo_griffinlim.wav",
        sr_gl_l,
        gl_l,
        gl_r,
    )

    metricas_left = leer_metricas_txt(out_left / "metricas_audio.txt")
    metricas_right = leer_metricas_txt(out_right / "metricas_audio.txt")

    datos_metricas = {
        "experimento": nombre_base,
        "sr": sr_l,
        "left_dir": str(out_left),
        "right_dir": str(out_right),
        "psnr_logmag_left": metricas_left.get("psnr_logmag_promedio", ""),
        "psnr_logmag_right": metricas_right.get("psnr_logmag_promedio", ""),
        "snr_left_db": metricas_left.get("snr_db", ""),
        "snr_right_db": metricas_right.get("snr_db", ""),
        "psnr_logmag_griffinlim_left": metricas_left.get("psnr_logmag_griffinlim", ""),
        "psnr_logmag_griffinlim_right": metricas_right.get("psnr_logmag_griffinlim", ""),
        "snr_griffinlim_left_db": metricas_left.get("snr_griffinlim_db", ""),
        "snr_griffinlim_right_db": metricas_right.get("snr_griffinlim_db", ""),
    }

    try:
        psnr_l = float(datos_metricas["psnr_logmag_left"])
        psnr_r = float(datos_metricas["psnr_logmag_right"])
        datos_metricas["psnr_logmag_promedio_LR"] = (psnr_l + psnr_r) / 2.0
    except Exception:
        datos_metricas["psnr_logmag_promedio_LR"] = ""

    try:
        snr_l = float(datos_metricas["snr_left_db"])
        snr_r = float(datos_metricas["snr_right_db"])
        datos_metricas["snr_promedio_LR_db"] = (snr_l + snr_r) / 2.0
    except Exception:
        datos_metricas["snr_promedio_LR_db"] = ""

    try:
        ruta_audio = Path(cfg["audio"])
        if not ruta_audio.is_absolute():
            ruta_audio = RAIZ / ruta_audio

        sr_orig, original = cargar_original_stereo(
            ruta_audio,
            sr_objetivo=cfg.get("sr"),
            max_segundos=cfg.get("max_segundos"),
        )

        if sr_orig != sr_l:
            raise RuntimeError("El sample rate original no coincide con el reconstruido")

        _, recon_stereo = leer_wav_float(out_stereo / "recon_stereo_fase_original.wav")
        m = calcular_metricas_stereo(original, recon_stereo)

        for k, v in m.items():
            datos_metricas[k] = v

    except Exception as e:
        datos_metricas["warning_metricas_stereo_global"] = str(e)

    escribir_metricas_stereo(out_stereo / "metricas_stereo.txt", datos_metricas)

    print("")
    print("============================================================")
    print(" LISTO")
    print("============================================================")
    print(f"salida stereo: {out_stereo}")
    print(f"LEFT: {out_left}")
    print(f"RIGHT: {out_right}")
    print("escucha:")
    print(f"  {out_stereo / 'recon_stereo_fase_original.wav'}")
    print(f"  {out_stereo / 'recon_stereo_griffinlim.wav'}")
    print("metricas:")
    print(f"  {out_stereo / 'metricas_stereo.txt'}")


if __name__ == "__main__":
    main()
